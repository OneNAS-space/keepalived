 1 file changed, 3 deletions(-)

diff --git a/files/etc/hotplug.d/keepalived/551-dnsmasq b/files/etc/hotplug.d/keepalived/551-dnsmasq
index 8254521..4e41354 100644
--- a/files/etc/hotplug.d/keepalived/551-dnsmasq
+++ b/files/etc/hotplug.d/keepalived/551-dnsmasq
@@ -5,9 +5,6 @@
 
 set_service_name dnsmasq
 
-set_restart_if_master
-set_stop_if_backup
-
 add_sync_file /etc/config/dhcp
 add_sync_file /tmp/dhcp.leases
 
