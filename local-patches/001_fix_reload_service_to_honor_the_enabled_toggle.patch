From b0bb6d46df8a9c2dc45d02aefa3e9a3f3b72f3e1 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Tue, 27 Oct 2026 17:33:46 +0800
Subject: [PATCH] Update reload_service to handle enabled state

Enhance reload_service to check if keepalived is enabled before reloading.

Signed-off-by: Jackie Han <jackie.han@gmail.com>
---
 net/keepalived/files/keepalived.init | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/net/keepalived/files/keepalived.init b/net/keepalived/files/keepalived.init
index 91360e3b17809b..2df050fabb8fa1 100644
--- a/net/keepalived/files/keepalived.init
+++ b/net/keepalived/files/keepalived.init
@@ -668,9 +668,18 @@ service_triggers() {
 }
 
 reload_service() {
-	process_config
-	#SIGHUP is used by keepalived to do init.d reload
-	procd_send_signal keepalived
+	local enabled
+
+	config_load 'keepalived'
+	config_get_bool enabled globals enabled 1
+
+	if [ "$enabled" = "1" ] && procd_running "keepalived"; then
+		process_config
+		# SIGHUP is used by keepalived to do init.d reload
+		procd_send_signal keepalived
+	else
+		start
+	fi
 }
 
 start_service() {
