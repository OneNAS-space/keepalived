From 2c035e04ff729668f0e0da87805341e8c9749220 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Wed, 28 Oct 2026 09:16:37 +0800
Subject: [PATCH] Update reload_service to handle enabled state

Enhance reload_service to check if keepalived is enabled before reloading.
---
 files/keepalived.init | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/files/keepalived.init b/files/keepalived.init
index ac59c81..ba87f31 100644
--- a/files/keepalived.init
+++ b/files/keepalived.init
@@ -647,9 +647,18 @@ service_triggers() {
 }
 
 reload_service() {
-	process_config
-	#SIGHUP is used by keepalived to do init.d reload
-	procd_send_signal keepalived
+	local enabled
+
+	config_load 'keepalived'
+	config_get_bool enabled globals enabled 1
+
+	if [ "$enabled" = "1" ] && procd_running "keepalived"; then
+		process_config
+		# SIGHUP is used by keepalived to do init.d reload
+		procd_send_signal keepalived
+	else
+		start
+	fi
 }
 
 start_service() {
